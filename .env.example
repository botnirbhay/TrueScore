# Pooled connection for the running app.
# For Supabase, this is usually the transaction pooler URL on port 6543.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/truescore?schema=public"

# Optional direct connection for migrations and Prisma Studio when using Supabase/managed Postgres.
# If you do not have a separate direct connection, reuse DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/truescore?schema=public"

